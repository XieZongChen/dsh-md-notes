{
  "name": "dsh-md-notes",
  "version": "0.13.0",
  "description": "A note-taking plugin for DeepSeek Harness (DSH). It provides a full MD notes manager and MD notes editor, letting you quickly capture conversation content into notes. Notes can be maintained by syncing to a Git repository.",
  "homepage": "https://github.com/XieZongChen/dsh-md-notes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XieZongChen/dsh-md-notes.git"
  },
  "bugs": {
    "url": "https://github.com/XieZongChen/dsh-md-notes/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "verify": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.client-test.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.e2e/browsers vitest run --config vitest.e2e.config.ts",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.e2e/browsers playwright install chromium",
    "test:watch": "vitest",
    "link-deps": "node scripts/link-deps.mjs",
    "bundle": "tsdown",
    "changelog:release": "node scripts/release-changelog.mjs",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.1.8",
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cosmokit": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-test-runtime": "*",
    "@deepseek-ai/dsh-client-ui-chat": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-input-trigger": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-settings-general": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-workspace-path": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
